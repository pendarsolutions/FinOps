# Copy to .env and fill in. Never commit .env.
PENDAR_ENV=dev                      # dev | staging | prod

# Database (compose builds the URL from these)
POSTGRES_USER=pendar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pendar

# Security (required in staging/prod)
PENDAR_JWT_SECRET=                  # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
PENDAR_CREDENTIALS_KEY=             # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PENDAR_CORS_ORIGINS=["https://finops.example.ir"]

# AI: "offline" (deterministic parser + templated advisor, no external calls) or "anthropic"
PENDAR_AI_PROVIDER=offline
PENDAR_AI_MODEL=claude-opus-5-5
PENDAR_ANTHROPIC_API_KEY=
PENDAR_AI_RATE_LIMIT_PER_MINUTE=20

# Invoices
PENDAR_INVOICE_RETENTION_DAYS=30
PENDAR_MAX_UPLOAD_MB=10

WEB_PORT=80
