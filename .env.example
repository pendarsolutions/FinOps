# Copy to .env and fill in. Never commit .env.
FINOPS_ENV=dev                      # dev | staging | prod

# Database (compose builds the URL from these)
POSTGRES_USER=finops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finops

# Security (required in staging/prod)
FINOPS_JWT_SECRET=                  # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
FINOPS_CREDENTIALS_KEY=             # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FINOPS_CORS_ORIGINS=["https://finops.example.ir"]

# Open sign-up. Leave false in production; the first account can always register.
FINOPS_ALLOW_REGISTRATION=false

# AI: "offline" (deterministic parser + templated advisor, no external calls) or "anthropic"
FINOPS_AI_PROVIDER=offline
FINOPS_AI_MODEL=claude-opus-5-5
FINOPS_ANTHROPIC_API_KEY=
FINOPS_AI_RATE_LIMIT_PER_MINUTE=20

# Invoices
FINOPS_INVOICE_RETENTION_DAYS=30
FINOPS_MAX_UPLOAD_MB=10

# Alerts for price changes and failed price updates (both optional)
FINOPS_SMTP_HOST=
FINOPS_SMTP_PORT=587
FINOPS_SMTP_USER=
FINOPS_SMTP_PASSWORD=
FINOPS_ALERT_EMAIL_TO=
FINOPS_BALE_BOT_TOKEN=
FINOPS_BALE_CHAT_ID=

WEB_PORT=80
